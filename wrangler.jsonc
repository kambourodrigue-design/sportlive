{
  "name": "sportlive",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Cache partagé entre visiteurs (protège le quota API-Football). Créé automatiquement au déploiement.
  "kv_namespaces": [{ "binding": "CACHE" }],
  "vars": {
    // Test solo : 60. Plan gratuit API-Football (100 req/jour) en usage public : 1200.
    "LIVE_CACHE_SECONDS": "60"
  }
}
